{
  "name": "@mercurifi/sdk",
  "version": "0.1.0-beta.0",
  "description": "TypeScript SDK for Mercurifi Agent Accounts on Arc",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-package-json.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "gen:abis": "node ../../scripts/gen-abis.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs && node scripts/smoke-dist.cjs"
  },
  "dependencies": {
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
